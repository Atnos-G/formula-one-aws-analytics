formula_one_aws_analytics:
  target: dev
  outputs:
    dev:
      type: athena
      s3_staging_dir: s3://formula-one-athena-results-gaetan-dev/athena/
      region_name: eu-west-1
      database: awsdatacatalog
      schema: dbt_staging
      work_group: primary
      aws_profile_name: formulaone

version: 2

models:
  - name: stg_races
    columns:
      - name: season
        tests: [not_null]
      - name: round
        tests: [not_null]

  - name: stg_drivers
    columns:
      - name: driver_id
        tests: [not_null, unique]

  - name: stg_constructors
    columns:
      - name: constructor_id
        tests: [not_null, unique]

  - name: stg_results
    columns:
      - name: season
        tests: [not_null]
      - name: round
        tests: [not_null]
      - name: driver_id
        tests: [not_null]
      - name: constructor_id
        tests: [not_null]

  - name: stg_qualifying
    description: "Qualifying flattené depuis raw_qualifying_json (1 ligne = 1 driver x 1 race)"
    columns:
      - name: season
        tests: [not_null]
      - name: round
        tests: [not_null]
      - name: driver_id
        tests: [not_null]
      - name: constructor_id
        tests: [not_null]
      - name: position
        tests: [not_null]